{
  "name": "chat2local",
  "version": "1.2.0",
  "description": "Chat-first local workbench: scoped file tools, disposable code-mode workers, resumable jobs and optional Aside",
  "type": "module",
  "scripts": {
    "start": "bun run bin/mcp.ts",
    "setup": "bun run bin/setup.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/tests/*.test.js",
    "bundle": "bun build bin/mcp.ts --target=bun --outfile release/chat2local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
